# Copy this file to .env and fill in the real password/keys. .env is gitignored.

# --- Database (Supabase Postgres, via Session Pooler — the direct
# db.<ref>.supabase.co host is IPv6-only and unreachable from some networks) ---
# Kept as separate parts (not one pre-assembled URL) so special characters
# in the password never need manual percent-encoding.
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.nquhpvsmhvvmbpsrwbua
DB_PASSWORD=

# --- Supabase Auth ---
# URL and ANON_KEY are not secret (meant to ship in client-side apps) —
# safe to leave filled in below. SERVICE_ROLE_KEY IS secret (bypasses all
# access rules) — never commit it, never share it in chat.
SUPABASE_URL=https://nquhpvsmhvvmbpsrwbua.supabase.co
SUPABASE_ANON_KEY=sb_publishable_NO39zK_ZrAjtFX6rIBpXYw_swKI1fil
SUPABASE_SERVICE_ROLE_KEY=
